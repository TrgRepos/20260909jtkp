{
  "mcpServers": {
    "staging-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "envmcp",
        "--env-file",
        "${workspaceFolder}/.env",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "$STAGING_DATABASE_URL"
      ]
    },
    "sample-github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_MCP_TOKEN}"
      }
    }
  }
}
