# Copy to .env and fill in locally. Never commit a real .env file.
# .env is already excluded via .cursorignore - do not remove that entry.

PORT=3000

# Local/staging only - never a production connection string.

# Uncomment for localhost with no TLS
#STAGING_DATABASE_URL=postgres://forecast_readonly:changeme@localhost:5432/project_forecasting_staging

# Uncomment for remote database with TLS
#STAGING_DATABASE_URL=postgres://forecast_readonly:changeme@<IP OR HOSTNAME>:5432/app?sslmode=require

# Uncomment to allow a self-signed certificate
#NODE_TLS_REJECT_UNAUTHORIZED=0

# Scoped, read-focused GitHub PAT for the sample-github MCP server.
GITHUB_MCP_TOKEN=ghp_replace_me
